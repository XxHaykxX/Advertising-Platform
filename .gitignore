# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded media (user content) — keep the folder, ignore files
/public/uploads/*
!/public/uploads/.gitkeep

# AWS migration staging: database dumps and the local mirror of the uploads
# tree (scripts/aws/*.sh). Gigabytes of user content plus a full DB dump —
# never in git.
/.migration/

# local dev artifacts
/prisma/dev.db
.next-dev.log
.gstack/

# playwright test output
.playwright-mcp/
test-results/
playwright-report/

# dev server logs
placement/dev-3001.log
*.log

# large local press-kit assets (keep out of git)
*.press*.pdf
/qa-*.jpeg

# root-level screenshot/test artifacts
/*.png
i18n-export.csv
# i18n round-trip artifacts (regenerated; keys live in src/lib/i18n.ts)
i18n-new-keys.csv
i18n-sheet-merged.csv

# Agent tooling, not the product. `.mcp.json` names Windows-only commands
# (npx.cmd) and this machine's server list, and .claude/agents holds prompt
# definitions — neither builds, ships or runs anything here, and both were
# tracked from the initial commit rather than by decision. Checked before
# removing: no literal credentials, only ${VAR} placeholders.
.claude/
.mcp.json

