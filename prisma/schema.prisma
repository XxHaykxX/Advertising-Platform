generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  PUBLISHER
  MODERATOR
  TRANSLATOR
  BRAND
  CREATOR
}

/// Moderation lifecycle for creator-submitted projects.
enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ProjectKind {
  FILM
  SERIAL
}

/// Self-serve member (BRAND / CREATOR) approval lifecycle. Staff users
/// (SUPERADMIN / PUBLISHER) are seeded as APPROVED and ignore this gate.
enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String?
  googleId     String?       @unique
  role         Role          @default(PUBLISHER)
  status       AccountStatus @default(APPROVED)
  name         String
  company      String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  avatar       String? // URL or data-URL avatar; falls back to initials from `name`
  phone        String? // contact phone (brand + creator profile)

  // ── member profile fields (#23) — nullable so existing rows (staff) stay
  // valid without a backfill. `website` is shared by brand + creator; the
  // brandCategories/budgetRange pair is brand-only. ──
  website         String? // homepage / portfolio URL (brand + creator)
  brandCategories String? @db.Text // JSON string[] — see src/lib/brand-categories.ts
  budgetRange     String? // one of BUDGET_RANGES in src/lib/brand-categories.ts

  projects  Project[]
  projectsUpdated Project[] @relation("ProjectUpdatedBy") // projects this user last saved
  interests Interest[] // Interest rows this user (as a BRAND) has expressed
  favorites Favorite[] // Favorite (shortlist) rows this user (as a BRAND) saved
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  uiDrafts      UiDraft[] // dictionary rows this staff user last edited (TRANSLATOR)
  i18nPublishes I18nPublish[] // publish clicks this staff user made
  contentVersions ContentVersion[] // content edits this user authored (history)
}

/// In-app notification (#25 / V9). Text is NOT stored translated — only a
/// `type` + a small JSON `data` payload; the UI renders localized copy in the
/// viewer's current locale (see src/lib/notifications.ts). `link` is an
/// in-app href the row navigates to when clicked.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int // recipient
  type      String // INTEREST | PROJECT_SUBMITTED | PROJECT_APPROVED | PROJECT_REJECTED
  data      String?  @db.Text // JSON payload: { projectTitle, brandName, projectId, … }; MySQL forbids TEXT defaults, so nullable — code treats null as "{}"
  link      String   @default("") // in-app href, e.g. "/reports/12" or "/admin/moderation"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// Web Push subscription (#push, 2026-07-20). One row per browser/device a user
/// granted notification permission on. `endpoint` is the push-service URL (long
/// → TEXT, so no unique index; dedup is done in code by deleting rows with the
/// same endpoint before inserting). p256dh/auth are the client's encryption keys
/// (from PushSubscription.getKey). Stale endpoints (410/404 on send) are pruned.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time password-reset tokens (email flow, #forgot-password). Only a
/// SHA-256 hash of the token is stored; the raw token lives solely in the
/// emailed link. A token is valid while usedAt IS NULL and expiresAt is in the
/// future. Old rows are left in place (not deleted on a new request) and simply
/// fail the validity check once expired/used.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// UI translation strings (ru/en/hy) — interface i18n only
model Content {
  key String @id
  ru  String @db.Text
  en  String @db.Text
  hy  String @db.Text
}

/// A film/series project listed for product placement
model Project {
  id             Int           @id @default(autoincrement())
  code           String        @unique // "#PP-2026-8540"
  title          String
  titleHy        String        @default("")
  titleRu        String        @default("")
  titleEn        String        @default("")
  genre          String
  synopsis       String        @db.Text
  synopsisHy     String?       @db.Text
  synopsisRu     String?       @db.Text
  synopsisEn     String?       @db.Text
  poster         String?
  gallery        String?       @db.Text // JSON string[]; nullable — MySQL forbids literal defaults on TEXT columns
  format         String        @default("") // "50 ep × 1m 15s"
  studio         String        @default("")
  countries      String        @default("") // "US, UK, …"
  ageRating      String        @default("") // content rating badge on the poster: "16+", "18+", "12+", …
  // Money — admin enters AMD only; the public site converts + formats for
  // display in the visitor's chosen currency (see src/lib/currency).
  boxOfficeAmd   Int? // box-office gross (кассовый сбор) — informational only, optional
  // Production budget, the CSV schema's "Budget". Distinct from boxOfficeAmd
  // above (gross receipts): the audit found the two conflated, and the owner
  // decided on 2026-07-26 to keep both as separate figures (decision C.3).
  productionBudgetAmd Int?
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)
  // How many times the public report page was opened. The creator had no
  // numbers at all about their own listing (audit 4.8) — not views, not how
  // many brands shortlisted it. Counted once per visitor per day (see the
  // /api/projects/[id]/view route), so a refresh loop can't inflate it.
  viewCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  // When this project was last saved, and by whom. The full edit history lives
  // in ContentVersion; these two are denormalized onto the row so the admin list
  // can show "changed 31.07 by Мариам" without joining history for every line.
  // Their absence is what made the 2026-07-31 damage impossible to trace.
  updatedAt      DateTime      @default(now()) @updatedAt
  updatedById    Int?
  ownerId        Int

  // ── Moderation & content-kind (added for the Creator submission flow) ──
  moderationStatus ModerationStatus @default(APPROVED) // existing rows stay visible; the creator flow will set PENDING
  // Why the last rejection happened. The moderator already typed one into a
  // prompt(), but it was thrown away (`void reason`) — so the creator got a
  // template email that never said what to fix. Persisted here and carried
  // into both the email and the creator's cabinet.
  rejectionReason  String?          @db.Text
  kind             ProjectKind      @default(FILM)
  episodes         Int? // episode count, for SERIAL
  episodeMinutes   Int? // per-episode runtime, for SERIAL
  durationMinutes  Int? // total runtime for a Single (FILM); Series uses episodes × episodeMinutes
  genres           String?          @db.Text // JSON string[] multi-genre; nullable, same pattern as platforms/cinemas — `genre` above stays as the primary display value
  formatCategory   String           @default("") // marketing format bucket (FEATURE|SERIES|SITCOM|…), separate from `kind`; drives the catalog Format filter
  language         String           @default("") // primary language (Armenian|Russian|English|…); drives the catalog Language filter

  applicationDeadline DateTime?
  // True for an open-ended call for offers — no concrete deadline (IA-42,
  // 2026-08-01). applicationDeadline stays NULL while this is set; the form
  // never submits both, and every save forces the pair back into that
  // agreement server-side (defense in depth).
  applicationDeadlineOngoing Boolean   @default(false)
  releaseDate         DateTime?
  // How much of releaseDate the editor actually entered — DAY | MONTH | YEAR
  // (IA-42, 2026-08-01). The date itself is stored at that precision's
  // placeholder (YEAR -> YYYY-01-01, MONTH -> YYYY-MM-01), and this column is
  // what decides how much of it is safe to render: the site must never show a
  // day/month the editor never gave. Existing rows default to DAY, matching
  // the exact dates they already carry.
  releasePrecision    String    @default("DAY")
  streamingSource     String?   @db.Text // JSON/CSV multi (Kinodaran|YouTube|TV|Cinema) — Production Info
  platforms           String?   @db.Text // JSON string[]; nullable — MySQL forbids literal defaults on TEXT columns

  // ── Real press-kit fields (added for the Aram title, 2026-07-09) ──
  tagline   String? // one-line logline, shown in the report hero (base/fallback, mirrors `synopsis`)
  taglineHy String? @db.Text // per-locale logline (IA-23 press-kit localization)
  taglineRu String? @db.Text
  taglineEn String? @db.Text
  references String? @db.Text // comparable titles ("Bohemian Rhapsody, Ray"), comma/JSON list
  cinemas    String? @db.Text // exhibition venues ("Cinema Star, Kino Park"), comma/JSON list

  // ── Video (detail page) — embed link and/or uploaded MP4 (#10) ──
  videoEmbedUrl String? // YouTube/Vimeo URL, embedded on the detail/report page
  videoFile     String? // uploaded MP4 path ("/uploads/…")

  owner         User                   @relation(fields: [ownerId], references: [id])
  updatedBy     User?                  @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  actors        Actor[]
  tiers         SponsorshipTier[]
  placements    Placement[]
  milestones    ProductionMilestone[]
  interests     Interest[]
  favorites     Favorite[]

  @@index([ownerId])
}

/// A single node on the per-project production timeline ("Փրոդուկցիայի ընթաց",
/// Kinodaran-style), edited inline in the admin project form and rendered as a
/// horizontal timeline on the report page. Free-text Armenian labels (no
/// per-locale columns — user decision 2026-07-25); exactly one row per project
/// should carry isActive=true (the current stage, highlighted). Order on the
/// timeline is sortOrder asc.
model ProductionMilestone {
  id        Int       @id @default(autoincrement())
  projectId Int
  label     String // stage name, e.g. "Պրեպրոդակշն"
  date      DateTime? // optional stage date (picker)
  note      String    @default("") // one free-text line, e.g. "Съёмки в Ереване"
  isActive  Boolean   @default(false) // the current stage — highlighted on the timeline
  sortOrder Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A person attached to a project (cast or crew), shown in the pitch materials
model Actor {
  id        Int    @id @default(autoincrement())
  projectId Int
  personId  Int? // link to the global Person directory (Ф3); null for legacy rows until backfilled
  name      String // legacy base — the ultimate fallback, same role as Project.title
  // Per-locale spellings, snapshotted from the linked Person on every project
  // save (2026-07-27). A name is a proper noun, so this is transliteration, not
  // translation: Արամ / Арам / Aram. Empty -> pickPersonName falls back to en,
  // then to `name`, so a half-filled directory still renders.
  nameHy    String @default("")
  nameRu    String @default("")
  nameEn    String @default("")
  role      String // legacy single role — kept as fallback; new code reads `roles`
  roles     String? @db.Text // JSON string[] of roles (Ф3 multi-role): one person can be Actor+Producer+…
  kind      String @default("CAST") // CAST | CREW — press-kits often list crew, not cast
  photo     String? // uploaded headshot path ("/uploads/…"); null -> initials avatar
  sortOrder Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person  Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([personId])
}

// Global, reusable cast & crew directory (#9). Managed from a dedicated admin
// section (/admin/cast); powers the per-project Cast & Crew autocomplete. The
// per-project Actor rows above keep their own name/role/photo snapshot, so
// editing/deleting a Person never mutates already-attached project cast.
// Global, editable dictionary of streaming-source options (Production Info field).
// Admin adds custom values in the project form; they persist here so every future
// project offers them, and deleting one removes it from the pool for all projects
// (user request 2026-07-25). Distinct from the free-text CSV stored per project on
// Project.streamingSource — this is only the reusable option list.
model StreamingSource {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @default(0)
}

/// Global, editable dictionary of countries offered by the project form's
/// "Content Original Countries" multi-select (2026-07-27). Same shape and same
/// reasoning as StreamingSource: the field was free text, so every editor typed
/// their own spelling ("US" / "USA" / "United States") and the catalog counted
/// them as different countries. Seeded from src/lib/countries.ts; a country
/// typed into one project is offered on every future one, and deleting one
/// removes it from the pool without touching what projects already store.
model Country {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @default(0)
}

/// Global, editable dictionary of production companies offered by the project
/// form's "Studio name" multi-select (2026-07-27). Third dictionary of the same
/// shape as StreamingSource/Country: Studio was a free-text input with a
/// <datalist> of past values, which did nothing to stop one company being
/// stored under three spellings. Seeded from src/lib/studios.ts; a studio typed
/// into one project is offered on every future one, and deleting one removes it
/// from the pool without touching what projects already store.
model Studio {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @default(0)
}

model Person {
  id        Int      @id @default(autoincrement())
  name      String // legacy base — kept as the ultimate fallback (see pickPersonName)
  // The directory is the single source of truth for how a person is spelled in
  // each locale; project Actor rows snapshot these three on save.
  nameHy    String   @default("")
  nameRu    String   @default("")
  nameEn    String   @default("")
  role      String   @default("") // default/typical role
  kind      String   @default("CAST") // CAST | CREW
  photo     String? // "/uploads/…" headshot; null -> initials avatar
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  actors Actor[] // per-project credits linked to this person (Ф3)
}

/// A sponsorship package/tier for a project (the core monetization offer):
/// a named price point with a list of included benefits. Distinct from
/// scene-level PlacementOpportunity — tiers are the productised sponsor deal.
model SponsorshipTier {
  id        Int     @id @default(autoincrement())
  projectId Int
  name      String // "Official Sponsor" | "General Sponsor" (+ per-locale later)
  priceAmd  Int // 20000000 / 30000000 / 40000000
  benefits  String  @db.Text // JSON string[] — the included-benefits bullet list
  image     String? // 16:9 still shown atop the card, same contract as Placement.image
  isExclusive Boolean @default(false) // shared (non-competing brands only) vs exclusive placement (CSV "Is Exclusive")
  totalSlots     Int? // total capacity of this placement (the "Y" in "3 of 10" on catalog cards)
  availableSlots Int? // still-open slots (CSV "Available Slots"); the "X" in "3 of 10"; null -> unspecified
  sortOrder Int     @default(0)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  interests Interest[] // applications aimed at this package (audit 2.3)

  @@index([projectId])
}

/// A product-placement opportunity inside a project — the brand appears in the
/// story itself (owner decision 2026-07-28). Distinct from SponsorshipTier,
/// which sells sponsorship (logo on promo materials, credits, premiere
/// invitations) and is labelled "Sponsors" in the UI.
///
/// Same shape as a tier plus a still, with ONE difference: `priceAmd` is
/// optional. A creator who hasn't priced an integration leaves it empty and the
/// storefront shows "on request" — the brand asks and the terms are negotiated,
/// rather than a made-up number being published.
model Placement {
  id          Int     @id @default(autoincrement())
  projectId   Int
  title       String // "Integration into the story", "Hero's car"
  description String  @db.Text // what the brand gets, one item per line (JSON string[], same as tier benefits)
  image       String? // still showing the scene/slot ("/uploads/…")
  priceAmd    Int? // null -> "on request"; the creator prices it only if they want to
  totalSlots     Int? // how many brands this opportunity can take
  availableSlots Int? // still open; null -> unspecified, same contract as SponsorshipTier
  sortOrder   Int     @default(0)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  interests Interest[]

  @@index([projectId])
}

/// A past placement case study shown in the portfolio/case-studies section
model Portfolio {
  id             Int      @id @default(autoincrement())
  title          String // legacy base — kept as the ultimate fallback (see pickLocale)
  titleHy        String   @default("")
  titleRu        String   @default("")
  titleEn        String   @default("")
  brand          String
  description    String   @db.Text // legacy base — kept as the ultimate fallback
  // Per-locale descriptions mirror Project.synopsisHy/Ru/En: nullable @db.Text
  // (MySQL forbids literal defaults on TEXT columns, and translated copy easily
  // exceeds the 191-char VarChar cap). Null/empty falls back to En, then base.
  descriptionHy  String?  @db.Text
  descriptionRu  String?  @db.Text
  descriptionEn  String?  @db.Text
  image          String?
  metrics        String?  @db.Text // JSON object, e.g. {"views":"2.1M","recall":"+38%"}
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

/// A studio/platform partner logo shown in the trust/partners strip
model Partner {
  id        Int     @id @default(autoincrement())
  name      String
  logo      String?
  url       String?
  sortOrder Int     @default(0)
}

/// Lead applications (Express Interest + contact form)
/// BRAND member's "Express Interest" on a project (#23 — brand cabinet).
/// A lightweight, per-user signal tied to an authenticated BRAND account
/// (drives /account/brand/interests). MUTUAL is reserved for a future
/// two-sided reveal (creator also expresses interest back) — not set
/// anywhere yet (TODO, see #23 report).
enum InterestStatus {
  SENT
  MUTUAL
  DECLINED
}

model Interest {
  id        Int             @id @default(autoincrement())
  brandId   Int
  projectId Int
  status    InterestStatus  @default(SENT)
  createdAt DateTime        @default(now())
  message   String?         @db.Text // latest application message from the brand (report popup)
  contact   String? // optional contact override supplied with the application

  // ── Wave 2 of the audit: closing the deal loop ──
  // Which placement package the brand applied for. Optional: applications sent
  // before this existed (and any sent from a project with no packages) carry
  // none. Answers audit 2.3 — "неизвестно, на какой пакет и сумму отклик".
  tierId       Int?
  // Which product placement the brand applied for (2026-07-29). Until now the
  // picker offered sponsorship packages only, so a brand that came for an
  // in-story integration — the thing the catalog advertises first — had no way
  // to name it and had to describe it in prose. Mutually exclusive with tierId
  // in practice: the popup is one picker over both lists.
  placementId  Int?
  // Which offer this application is FOR, as one comparable value: "P:5" for a
  // placement, "T:3" for a sponsorship package, "-" when the brand named
  // nothing. It exists only to be part of the uniqueness rule below — a
  // composite unique over (tierId, placementId) would not work, because MySQL
  // lets NULL repeat, so every "no offer named" application would count as
  // distinct and the same brand could pile up dozens of them on one project.
  // Always derived from the two ids above, never entered by hand.
  offerKey     String @default("-") @db.VarChar(24)
  // True while this application holds one of that package's availableSlots.
  // Set when a creator accepts, released when they decline or the brand
  // withdraws — so two brands can no longer both "take" one exclusive slot.
  slotReserved Boolean   @default(false)
  respondedAt  DateTime? // when the creator accepted/declined
  responseNote String?   @db.Text // what the creator wrote back

  // ── The brief itself (2026-07-26) ──
  // The application used to be one free-text box, so the three facts a seller
  // actually needs to answer — what is being placed, when, and whether money
  // or barter is on the table — arrived only if the brand happened to type
  // them. Industry guides on placement briefs list exactly these as the
  // minimum a brand must state up front. All optional: applications sent
  // before this existed carry none, and a brand that says it all in prose
  // still gets through.
  productInfo   String? @db.Text // what is being placed (product / service)
  desiredTiming String? // when the brand wants the placement, free text
  dealType      String? // CASH | BARTER | BOTH — how the brand intends to pay
  // What the brand is prepared to pay, in AMD — the currency the seller priced
  // in. Added 2026-07-29: the brief carried the brand's budget range from its
  // profile but no sum for THIS deal, which left a placement priced "on
  // request" with nowhere to make an offer at all.
  offerAmountAmd Int?

  brand     User             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tier      SponsorshipTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  placement Placement?       @relation(fields: [placementId], references: [id], onDelete: SetNull)
  events    InterestEvent[]

  // One application per brand per OFFER, not per project (owner decision
  // 2026-07-29). It used to be @@unique([brandId, projectId]) with an upsert on
  // top, so a brand that applied for a second placement silently overwrote its
  // first application — including one the creator had already accepted, whose
  // reserved slot went back on sale with nobody told. The page now carries an
  // apply button on every offer card, which made that one click away.
  @@unique([brandId, projectId, offerKey])
  @@index([brandId, projectId])
  @@index([projectId])
  @@index([tierId])
  @@index([placementId])
}

/// One entry in an application's history. The Interest row above stays the
/// CURRENT state of a brand↔project conversation (that pair is unique, and a
/// resend overwrites it) — this table keeps what used to be overwritten: every
/// application the brand sent and every answer the creator gave, with dates
/// (audit 2.6, "истории обращений нет ни у бренда, ни у площадки").
/// Deliberately a log, not a chat: in-platform messaging was postponed by the
/// owner on 2026-07-26 (decision C.2).
model InterestEvent {
  id         Int             @id @default(autoincrement())
  interestId Int
  kind       String // APPLICATION (from the brand) | RESPONSE (from the creator/staff)
  status     InterestStatus? // the status this event set, for RESPONSE rows
  body       String?         @db.Text // the message / the answer
  contact    String? // contact supplied with an APPLICATION
  // The brief as it stood in THIS round (see Interest above). Kept per event
  // so a resend with new terms doesn't rewrite what was originally offered.
  productInfo   String? @db.Text
  desiredTiming String?
  dealType      String?
  offerAmountAmd Int?
  authorId   Int? // who wrote it; null if that account was deleted
  createdAt  DateTime        @default(now())

  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@index([interestId])
}

/// Private brand shortlist ("favorite" heart on cards) — separate from Interest.
/// Admins do NOT see favorites; this is the brand's own saved list.
model Favorite {
  id        Int      @id @default(autoincrement())
  brandId   Int
  projectId Int
  createdAt DateTime @default(now())

  brand   User    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([brandId, projectId])
  @@index([projectId])
}

/// Colour a translator can stamp on a dictionary row — the direct replacement
/// for the row highlighting she used to do in the Google Sheet (CSV never
/// carried colours). Meanings are shown in the editor's legend:
///   GREEN — checked, final;  RED — problem / needs a decision;
///   BLUE  — in progress, come back to it;  NONE — untouched.
enum UiDraftMark {
  NONE
  GREEN
  RED
  BLUE
}

/// Working copy of one UI-dictionary entry, edited in /admin/i18n.
///
/// Rows exist ONLY for keys a translator has touched; the committed values in
/// src/lib/i18n.ts stay the source of truth. On "publish" the drafts are
/// written into that file via a GitHub commit, which triggers the Hostinger
/// rebuild — so a published draft still differs from the *running* build for
/// a few minutes. That is why rows survive publishing (`publishedAt` marks
/// them) and are pruned only once the deployed dictionary has caught up
/// (see pruneSettledDrafts in the i18n admin page).
model UiDraft {
  key         String      @id @db.VarChar(191) // dictionary key, e.g. "nav.catalog"
  hy          String      @db.Text
  ru          String      @db.Text
  en          String      @db.Text
  mark        UiDraftMark @default(NONE) // colour highlight, see UiDraftMark
  note        String?     @db.Text // translator's own remark, replaces sheet cell comments
  updatedAt   DateTime      @updatedAt
  updatedById Int? // last editor; null if that staff account was deleted
  publishedAt DateTime? // set when this exact value was committed to git

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([publishedAt])
}

/// One "publish" click: the commit that carried N dictionary keys into git.
/// Rendered in the editor header so the translator can see whether her last
/// save actually landed (and open the commit / build if it did not).
model I18nPublish {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    Int? // who clicked; null if that account was deleted
  keyCount  Int // dictionary keys carried by this commit
  commitSha String   @db.VarChar(64)
  commitUrl String   @db.Text

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// One saved state of a content record — the site's undo history (2026-07-31).
///
/// Why it exists: until now nothing recorded who changed a project or when, so
/// when content was damaged there was no way to find the edit, name the author,
/// or put the old text back. The dictionary already had this (I18nPublish +
/// the git commit); content had nothing.
///
/// One row per save, not per field and not per day: pressing Save writes a
/// version, and any version can be restored. The UI groups consecutive edits by
/// the same author into one collapsible line, but that is display only — every
/// version is kept and individually restorable.
///
/// `snapshot` holds the whole aggregate, so a Project row carries its cast,
/// tiers, placements and milestones with it and a restore can put all of them
/// back together. It is LongText rather than Json: the file-usage lookup needs a
/// cheap substring match, and prod is MariaDB, whose JSON support differs from
/// MySQL 8's.
model ContentVersion {
  id       Int    @id @default(autoincrement())
  entity   String @db.VarChar(32) // Project | Person | Portfolio | Partner
  entityId Int
  version  Int // 1, 2, 3… within one entity+entityId
  /// CREATE | UPDATE | DELETE | RESTORE | PUBLISH | UNPUBLISH
  action   String @db.VarChar(16)

  snapshot String @db.LongText // full aggregate state as JSON

  /// Every /uploads/… path found in the snapshot, newline-separated. Denormalized
  /// so the media library can answer "which versions still reference this file?"
  /// without parsing every snapshot.
  mediaPaths String? @db.Text

  /// Which fields changed against the previous version ("описание (ru), постер").
  /// Computed on write — the history list must not have to diff two snapshots to
  /// render a line.
  summary String? @db.Text

  authorId Int? // null once that account is deleted
  /// Author's name copied at write time, so history stays readable after the
  /// account is gone (authorId goes null, this does not).
  authorName String   @db.VarChar(191)
  createdAt  DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([entity, entityId, version])
  @@index([entity, entityId, createdAt])
  @@index([createdAt]) // the site-wide feed at /admin/history
  @@index([authorId])
}
